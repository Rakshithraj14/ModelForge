# Required by callers of POST /predict: Authorization: Bearer <APP_API_KEY>
APP_API_KEY=

# Shared secret with the Worker — must match TELEMETRY_API_KEY in worker/.dev.vars (or the
# deployed Worker's secret). Used by app.py to authenticate its telemetry POSTs.
TELEMETRY_API_KEY=

# Worker's telemetry ingestion endpoint. Local dev default shown; swap for the deployed
# Worker URL in production.
MODEL_DOCTOR_TELEMETRY_URL=http://localhost:8787/api/v1/telemetry
